# URL publique du site (utilisée pour les meta tags SEO)
NEXT_PUBLIC_SITE_URL=https://obsidian-arts-films.fr

# Clé API Resend pour l'envoi d'emails via le formulaire de contact
# Créer un compte sur https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse email qui reçoit les demandes de devis
# Doit être vérifiée dans Resend (ou utiliser le domaine vérifié)
CONTACT_EMAIL=contact@obsidian-arts-films.fr
